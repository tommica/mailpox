{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "tommica/mailpox",
    "description": "A local development mailbox for Laravel applications.",
    "keywords": [
        "laravel",
        "mail",
        "mailbox",
        "development"
    ],
    "license": "Unlicense",
    "authors": [
        {
            "name": "Tom Mica"
        }
    ],
    "require": {
        "php": "^8.0|^8.1|^8.2|^8.3|^8.4",
        "illuminate/cache": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/mail": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "symfony/mailer": "^6.0|^7.0|^8.0",
        "symfony/mime": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^9.5|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Tommica\\Mailpox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tommica\\Mailpox\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "analyse": "phpstan analyse src --level=6 --memory-limit=512M"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tommica\\Mailpox\\MailpoxServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
